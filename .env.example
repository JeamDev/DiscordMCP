# Bot token from https://discord.com/developers/applications — never a user token.
DISCORD_BOT_TOKEN=
# Optional default server. Copy its ID with Discord Developer Mode enabled.
DISCORD_GUILD_ID=
# Optional comma-separated server allowlist. Empty = all servers the bot belongs to.
DISCORD_ALLOWED_GUILD_IDS=
# Local uploads/audio/images are read only from this directory, including symlinks.
DISCORD_ASSET_DIR=./assets
# REST works without a Gateway connection. Voice/listening connect on first use.
# Enable privileged intents here AND on the Bot page if you need them.
DISCORD_MESSAGE_CONTENT=false
DISCORD_GUILD_MEMBERS=false
DISCORD_EVENT_BUFFER_SIZE=200
