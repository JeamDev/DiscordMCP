{
  "name": "discord-control-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Local stdio MCP server for Discord administration through an official bot.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "register": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-codex.ps1",
    "doctor": "node dist/doctor.js",
    "demo:sound": "node scripts/demo-sound.mjs"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.1.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
